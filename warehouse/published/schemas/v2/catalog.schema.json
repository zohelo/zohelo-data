{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zohelo.com/schemas/published/v2/catalog.schema.json",
  "title": "06_published/v2/catalog.json",
  "type": "object",
  "required": [
    "version",
    "generated_at",
    "kpis",
    "dimensions",
    "geographies",
    "units",
    "domains",
    "sources",
    "licences"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?Z$"
    },
    "kpis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kpi_key",
          "name_pl",
          "name_en",
          "definition_pl",
          "definition_en",
          "unit_key",
          "frequency",
          "domain_key",
          "group_key",
          "source_keys",
          "geographies",
          "dimension_keys",
          "first_period",
          "last_period",
          "aggregation",
          "polarity",
          "loaded_at",
          "next_release",
          "status"
        ],
        "properties": {
          "kpi_key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name_pl": {
            "type": "string"
          },
          "name_en": {
            "type": "string"
          },
          "definition_pl": {
            "type": "string"
          },
          "definition_en": {
            "type": "string"
          },
          "unit_key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "frequency": {
            "type": "string",
            "enum": [
              "M",
              "Q",
              "A"
            ]
          },
          "domain_key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"
          },
          "group_key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"
          },
          "source_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          },
          "geographies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^([A-Z]{2}|EU27|PL-[0-9]{2})$"
            }
          },
          "dimension_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          },
          "first_period": {
            "type": "string",
            "pattern": "^[0-9]{4}(-Q[1-4]|-(0[1-9]|1[0-2]))?$"
          },
          "last_period": {
            "type": "string",
            "pattern": "^[0-9]{4}(-Q[1-4]|-(0[1-9]|1[0-2]))?$"
          },
          "aggregation": {
            "type": "string",
            "enum": [
              "sum",
              "mean",
              "rate",
              "index",
              "none"
            ]
          },
          "polarity": {
            "type": "string",
            "enum": [
              "up",
              "down",
              "neutral"
            ]
          },
          "loaded_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?Z$"
          },
          "next_release": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dimension_key",
          "name_pl",
          "name_en",
          "members"
        ],
        "properties": {
          "dimension_key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name_pl": {
            "type": "string"
          },
          "name_en": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "name_pl",
                "name_en",
                "sort"
              ],
              "properties": {
                "key": {
                  "type": "string"
                },
                "name_pl": {
                  "type": "string"
                },
                "name_en": {
                  "type": "string"
                },
                "sort": {
                  "type": "integer"
                },
                "parent_key": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "geographies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "name_pl",
          "name_en",
          "level",
          "eu"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^([A-Z]{2}|EU27|PL-[0-9]{2})$"
          },
          "name_pl": {
            "type": "string"
          },
          "name_en": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "country",
              "voivodeship",
              "aggregate"
            ]
          },
          "eu": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "unit_key",
          "symbol",
          "name_en",
          "name_pl",
          "is_rate",
          "decimals"
        ],
        "properties": {
          "unit_key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "symbol": {
            "type": "string"
          },
          "name_en": {
            "type": "string"
          },
          "name_pl": {
            "type": "string"
          },
          "is_rate": {
            "type": "boolean"
          },
          "decimals": {
            "type": "integer"
          },
          "base_unit_key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "factor": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$"
          }
        },
        "additionalProperties": true
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "domain_key",
          "level",
          "parent_key",
          "name_en",
          "name_pl"
        ],
        "properties": {
          "domain_key": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "parent_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "name_en": {
            "type": "string"
          },
          "name_pl": {
            "type": "string"
          },
          "sort": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_key",
          "name_pl",
          "name_en",
          "licence_key",
          "register_id"
        ],
        "properties": {
          "source_key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name_pl": {
            "type": "string"
          },
          "name_en": {
            "type": "string"
          },
          "licence_key": {
            "type": "string"
          },
          "register_id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "licences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "licence_key",
          "name",
          "url",
          "attribution_text",
          "commercial_ok"
        ],
        "properties": {
          "licence_key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "attribution_text": {
            "type": "string"
          },
          "commercial_ok": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
