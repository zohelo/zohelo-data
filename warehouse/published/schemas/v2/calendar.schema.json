{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zohelo.com/schemas/published/v2/calendar.schema.json",
  "title": "06_published/v2/calendar.json",
  "type": "object",
  "required": [
    "version",
    "generated_at",
    "releases"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?Z$"
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "source_key",
          "kpi_keys",
          "title_pl",
          "title_en",
          "url"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "source_key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "kpi_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          },
          "title_pl": {
            "type": "string"
          },
          "title_en": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
