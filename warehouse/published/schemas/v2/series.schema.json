{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zohelo.com/schemas/published/v2/series.schema.json",
  "title": "06_published/v2/kpi/<kpi_key>/series.json",
  "type": "object",
  "required": [
    "kpi_key",
    "frequency",
    "unit_key",
    "periods",
    "series"
  ],
  "properties": {
    "kpi_key": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "M",
        "Q",
        "A"
      ]
    },
    "unit_key": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "periods": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{4}(-Q[1-4]|-(0[1-9]|1[0-2]))?$"
      }
    },
    "periods_by_frequency": {
      "description": "optional: the periods of each other frequency than `frequency` that a series uses, sorted; a series with its own `frequency` has one value or null per entry of that list",
      "type": "object",
      "properties": {
        "M": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
          }
        },
        "Q": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{4}-Q[1-4]$"
          }
        },
        "A": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{4}$"
          }
        }
      },
      "additionalProperties": false
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "geography",
          "source_key",
          "unit_key",
          "members",
          "values"
        ],
        "properties": {
          "geography": {
            "type": "string",
            "pattern": "^([A-Z]{2}|EU27|PL-[0-9]{2})$"
          },
          "source_key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "unit_key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "members": {
            "type": "object"
          },
          "frequency": {
            "description": "optional: present only when the series has another frequency than the KPI's; its values follow periods_by_frequency of that frequency",
            "type": "string",
            "enum": [
              "M",
              "Q",
              "A"
            ]
          },
          "values": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "flags": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
