{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zohelo.com/schemas/published/v2/briefs.schema.json",
  "title": "06_published/v2/briefs.json",
  "type": "object",
  "required": [
    "version",
    "generated_at",
    "window_days",
    "extreme_min_periods",
    "geographies",
    "briefs",
    "detections"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?Z$"
    },
    "window_days": {
      "type": "integer"
    },
    "extreme_min_periods": {
      "type": "integer"
    },
    "geographies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([A-Z]{2}|EU27|PL-[0-9]{2})$"
      }
    },
    "briefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kpi_key",
          "geography",
          "source_key",
          "unit_key",
          "period",
          "value",
          "previous_period",
          "previous_value",
          "change",
          "change_unit",
          "year_ago_period",
          "year_ago_value",
          "year_ago_change",
          "extreme",
          "flags",
          "released_at",
          "released_at_source",
          "detected_at",
          "next_release"
        ],
        "properties": {
          "kpi_key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "geography": {
            "type": "string",
            "pattern": "^([A-Z]{2}|EU27|PL-[0-9]{2})$"
          },
          "source_key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "unit_key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "period": {
            "type": "string",
            "pattern": "^[0-9]{4}(-Q[1-4]|-(0[1-9]|1[0-2]))?$"
          },
          "value": {
            "type": "number"
          },
          "previous_period": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}(-Q[1-4]|-(0[1-9]|1[0-2]))?$"
          },
          "previous_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "change": {
            "description": "value minus previous_value (change_unit pp or diff) or the relative change in % (change_unit %); null without a previous value or for a % change from a value not above zero",
            "type": [
              "number",
              "null"
            ]
          },
          "change_unit": {
            "type": "string",
            "enum": [
              "pp",
              "diff",
              "%"
            ]
          },
          "year_ago_period": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}(-Q[1-4]|-(0[1-9]|1[0-2]))?$"
          },
          "year_ago_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "year_ago_change": {
            "description": "as change, against year_ago_value",
            "type": [
              "number",
              "null"
            ]
          },
          "extreme": {
            "description": "null, or the value is the highest/lowest for at least extreme_min_periods observed values back; since_period: the last period with a value as high (low) or more, null for a record over the whole series",
            "type": [
              "object",
              "null"
            ],
            "required": [
              "kind",
              "since_period",
              "periods"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "highest",
                  "lowest"
                ]
              },
              "since_period": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]{4}(-Q[1-4]|-(0[1-9]|1[0-2]))?$"
              },
              "periods": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "released_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "released_at_source": {
            "type": "string",
            "enum": [
              "calendar",
              "detected"
            ]
          },
          "detected_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?Z$"
          },
          "next_release": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "the KPI's first calendar.json date after released_at"
          }
        },
        "additionalProperties": true
      }
    },
    "detections": {
      "description": "writer state, not for display: every KPI x geography x period detected as new in the last window_days (detected_at, release date), so a period keeps its detected_at across runs",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kpi_key",
          "geography",
          "period",
          "detected_at",
          "released_at",
          "released_at_source"
        ],
        "properties": {
          "kpi_key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "geography": {
            "type": "string",
            "pattern": "^([A-Z]{2}|EU27|PL-[0-9]{2})$"
          },
          "period": {
            "type": "string",
            "pattern": "^[0-9]{4}(-Q[1-4]|-(0[1-9]|1[0-2]))?$"
          },
          "detected_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?Z$"
          },
          "released_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "released_at_source": {
            "type": "string",
            "enum": [
              "calendar",
              "detected"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
