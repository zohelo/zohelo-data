{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zohelo.com/schemas/published/v2/latest.schema.json",
  "title": "06_published/v2/latest.json",
  "type": "object",
  "required": [
    "version",
    "generated_at",
    "values"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?Z$"
    },
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kpi_key",
          "geography",
          "source_key",
          "unit_key",
          "period",
          "value",
          "previous_period",
          "previous_value",
          "year_ago_value",
          "flags",
          "checked_at"
        ],
        "properties": {
          "kpi_key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "geography": {
            "type": "string",
            "pattern": "^([A-Z]{2}|EU27|PL-[0-9]{2})$"
          },
          "source_key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "unit_key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "period": {
            "type": "string",
            "pattern": "^[0-9]{4}(-Q[1-4]|-(0[1-9]|1[0-2]))?$"
          },
          "value": {
            "type": "number"
          },
          "previous_period": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}(-Q[1-4]|-(0[1-9]|1[0-2]))?$"
          },
          "previous_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "year_ago_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "checked_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?Z$"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
